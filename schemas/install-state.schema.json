{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Writing deployment ownership and independent backups",
  "type": "object",
  "required": ["schemaVersion", "home", "roots", "targets", "mcp", "staging", "siblings"],
  "properties": {
    "schemaVersion": {"const": 1}, "home": {"type": "string"},
    "roots": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "targets": {"type": "array", "items": {
      "type": "object", "required": ["source", "target", "backup", "installedSha256", "originalSha256", "applied"],
      "properties": {
        "source": {"type": "string"}, "target": {"type": "string"}, "backup": {"type": "string"},
        "kind": {"enum": ["skill", "resource"]},
        "installedSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "originalSha256": {"type": ["string", "null"]}, "applied": {"type": "boolean"}
      }, "additionalProperties": false
    }},
    "mcp": {"type": "object", "required": ["configPath", "stagedConfigPath", "previous", "installed"]},
    "staging": {"type": "object", "required": ["argv", "cwd"], "properties": {
      "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "cwd": {"type": "string"}
    }, "additionalProperties": false},
    "siblings": {"type": "object"}, "mcpApplied": {"type": "boolean"}, "mcpAcceptance": {"type": "object"}
  }, "additionalProperties": false
}
